# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key

/app/assets/builds/*
!/app/assets/builds/.keep

# B2BWave exports containing customer PII: names, emails, phone numbers and
# postal addresses for ~360 wholesale customers, plus their full order history.
# These are migration inputs only and must never reach the repo or Render.
# The catalog price list is NOT ignored -- it holds no personal data and is the
# input to script/extract_b2bwave.py.
/b2bwave_source_files/customers_*.xlsx
/b2bwave_source_files/orders_*.xlsx

# Extracted customer/order data is the same PII in JSON form. products.json and
# product_images/ ARE committed -- they hold no personal data.
/db/import_data/customers.json
/db/import_data/orders.json

# Product photos pulled from the public site by
# script/scrape_public_site_images.py. No personal data -- these are ignored for
# size: 83MB against 6MB for product_images/, and a git repo never forgets a
# blob. The manifest and the hand-checked SKU overrides ARE committed, so
# re-running the script reproduces the same import.
/db/import_data/scraped_images/*
!/db/import_data/scraped_images/manifest.json
!/db/import_data/scraped_images/sku_overrides.json

# Square retail exports. Same reason as the B2BWave order export above, and
# then some: these carry retail customer names (4,708 rows), customer ids,
# payment tokens and card PAN suffixes. Card data must never reach the repo.
# The aggregates derived from them -- product_retail_frequency.json and
# docs/product_retail_frequency.xlsx -- hold units, dollars and dates only, and
# ARE committed, along with the hand-checked retail_item_map.json needed to
# reproduce them.
/retail sales data/
