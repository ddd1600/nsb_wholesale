<div class="product-submit">
  <%= render 'cart_line_items/product_availability', product: product %>

  <div class="flex items-center justify-start gap-x-7">
    <div class="text-input">
      <%= number_field_tag "quantity", 1, step: 1, min: 1, class: 'min-w-[100px]',
            data: { product_page_target: 'quantity', action: 'input->product-page#update change->product-page#update' } %>
    </div>
    <% cta_label = content_tag(:span, "#{t('spree.add_to_cart')} — ") + content_tag(:span, display_price(product), id: 'cta_price', data: { product_page_target: 'ctaPrice' }) %>
    <%= render partial: "shared/call_to_action", :locals => { :label => cta_label, :id => 'add-to-cart-button', :url => nil, :data => { product_page_target: 'submit' } } %>
  </div>
</div>
