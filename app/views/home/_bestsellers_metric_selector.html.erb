<%#
  Picks which demand figures the page shows: which channel, and how it is
  measured. Plain links with query params rather than Stimulus -- four
  combinations, no state to keep, and the choice stays shareable in the URL.

  Wholesale and retail are separate rankings over separate data, not two filters
  on one set, hence two rows rather than a single list of four.
%>
<%
  groups = [
    { legend: "Channel", param: :channel, current: ranking.channel,
      options: Nsb::DemandRanking::CHANNELS },
    { legend: "Measured by", param: :rank_by, current: ranking.metric,
      options: Nsb::DemandRanking::METRICS }
  ]
%>
<div class="flex flex-col gap-y-4 md:items-end">
  <% groups.each do |group| %>
    <fieldset class="flex flex-col gap-y-2 md:items-end">
      <legend class="text-body-xs uppercase tracking-wider text-gray-600 dark:text-gray-300 mb-2">
        <%= group[:legend] %>
      </legend>

      <div class="inline-flex rounded-full bg-gray-100 p-1 dark:bg-gray-800">
        <% group[:options].each do |key, option| %>
          <%
            selected = group[:current] == key
            classes = selected ?
              'bg-red-500 text-white' :
              'text-gray-700 hover:text-black dark:text-gray-300 dark:hover:text-white'
            params_for_link = { channel: ranking.channel, rank_by: ranking.metric }.merge(group[:param] => key)
          %>
          <%= link_to option[:label],
                root_path(params_for_link),
                class: "px-5 py-2 rounded-full text-body-sm font-sans-md whitespace-nowrap transition-colors duration-200 #{classes}",
                aria: { current: selected ? 'true' : nil } %>
        <% end %>
      </div>
    </fieldset>
  <% end %>
</div>
