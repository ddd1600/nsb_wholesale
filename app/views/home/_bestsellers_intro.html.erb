<%#
  Headline plus the channel and metric selectors. Dates are read from the ranking
  data rather than hardcoded, so re-running the aggregation scripts against fresh
  exports updates the copy too.
%>
<section class="wrapper pt-6 pb-10 md:pt-10 md:pb-14">
  <div class="grid-container items-end">
    <div class="col-span-full md:col-span-7">
      <h1 class="font-serif text-h4 md:text-h3">
        Most-ordered products
        <span class="text-red-500">&middot; <%= ranking.channel_label.downcase %></span>
      </h1>
      <p class="text-body md:text-body-md mt-4 max-w-xl text-gray-700 dark:text-gray-200">
        Ranked by <%= ranking.metric_label.downcase %> across all
        <%= ranking.blurb %> between
        <%= l ranking.first_date, format: "%B %Y" %> and
        <%= l ranking.last_date, format: "%B %Y" %>.
        <%= ranking.channel_label %> and
        <%= ranking.channel == :retail ? "wholesale" : "retail" %> demand are
        counted separately; these percentages are shares of
        <%= ranking.channel_label.downcase %> only.
      </p>
    </div>

    <div class="col-span-full md:col-span-5 mt-6 md:mt-0 md:justify-self-end">
      <%= render "home/bestsellers_metric_selector", ranking: ranking %>
    </div>
  </div>
</section>
