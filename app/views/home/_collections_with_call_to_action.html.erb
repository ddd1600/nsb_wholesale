<section class="grid-container grid-cols-1 gap-7 wrapper py-4 lg:py-12 lg:grid-cols-3">
  <%#
    Was starter-template marketing copy ("Become the brand everyone talks
    about.") with a "Get Started" button pointing at solidus.io -- i.e. the
    storefront was sending New South Botanicals' wholesale customers to the
    ecommerce framework's website. Replaced with something true of this store.
  %>
  <div class="flex flex-col items-center justify-center py-10 px-3">
    <span class="text-h2.5 text-center font-serif mb-5">Wholesale, reordered in minutes.</span>
    <%= render "shared/call_to_action", { label: "Browse the catalog", type: 'secondary', url: products_path } %>
  </div>

  <% products.each_with_index do |product, index| %>
    <%
      product_image = product.gallery.images.second || product.gallery.images.first
    %>

    <%# Not fragment-cached on purpose: the cached HTML would freeze Active
        Storage's signed image URLs, which expire after minutes -- the cache
        outlived them and every product image 404'd. At ~1 order/day there is
        nothing to gain from caching this anyway. %>
    <%= link_to product_path(product) do %>
      <div class="relative bg-gray-50 overflow-hidden rounded-lg h-full md:rounded-xl lg:rounded-2xl">
        <%= render(ImageComponent.new(
          image: product_image,
          class: 'w-full h-full object-cover',
          size: :full,
        )) %>
        <%# The caption sits ON the product photo, which in this catalog is a
            white-background bottle shot. It must stay dark in both themes --
            inheriting the dark-mode sand body color made it invisible here. %>
        <div class="absolute bottom-0 left-0 right-0 flex flex-col items-start w-full dark:text-black gap-y-1 p-3 !pt-0 md:p-6 md:flex-row md:justify-between md:items-center md:gap-y-0 md:gap-x-2">
          <span class="w-full text-body-sm md:text-body">
            <%= product.name %>
          </span>
          <span class="text-body-sm md:text-body font-sans-md price selling">
            <%= product.display_price %>
          </span>
        </div>
      </div>
    <% end %>
  <% end %>
</section>
