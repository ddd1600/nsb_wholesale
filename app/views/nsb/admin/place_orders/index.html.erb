<% admin_breadcrumb("Place an order") %>

<div class="row">
  <div class="col-12">
    <h1>Place an order for a customer</h1>

    <p>
      Click <strong>Shop as this customer</strong> next to the customer.
      You'll be taken to the store signed in as them, with a yellow bar across
      the top. Add products to the cart and check out as normal -- the order
      is theirs, and your name is recorded as the person who placed it. Click
      <strong>Stop</strong> in the yellow bar when you're done to get back to
      the admin.
    </p>

    <%= form_tag admin_place_order_path, method: :get, class: "mb-4" do %>
      <div class="d-flex" style="gap: 8px; max-width: 600px;">
        <%= search_field_tag :q, @query, placeholder: "Filter by business, contact or email",
              class: "form-control" %>
        <%= submit_tag "Filter", name: nil, class: "btn btn-primary" %>
        <% if @query.present? %>
          <%= link_to "Show all", admin_place_order_path, class: "btn btn-default" %>
        <% end %>
      </div>
    <% end %>

    <% if @entries.empty? %>
      <p>No customers match "<%= @query %>".</p>
    <% else %>
      <table class="index">
        <thead>
          <tr><th>Business</th><th>Contact</th><th>Last order</th><th></th></tr>
        </thead>
        <tbody>
          <% @entries.each do |entry| %>
            <tr>
              <td><strong><%= entry.business_name %></strong></td>
              <td><%= entry.contact_name %><br><%= entry.user.email %></td>
              <td>
                <% if entry.last_order_on %>
                  <%= entry.last_order_on.to_fs(:long) %>
                  <% if entry.last_order_source == :b2bwave %><br><small class="text-muted">on B2BWave</small><% end %>
                <% else %>
                  <span class="text-muted">None on record</span>
                <% end %>
              </td>
              <td class="actions">
                <%= button_to "Shop as this customer",
                      admin_impersonations_path(user_id: entry.user.id),
                      method: :post, class: "btn btn-primary" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <%= paginate @entries, theme: "solidus_admin" %>
    <% end %>
  </div>
</div>
