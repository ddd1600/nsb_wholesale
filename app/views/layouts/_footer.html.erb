<footer class="wrapper mx-auto grid-container w-full">
  <div class="col-span-full border-t-[1px] border-t-black dark:border-t-white py-16">
    <div class="text-center col-span-full md:flex md:items-center md:justify-between md:col-start-2 md:col-span-10">
      <%#
        Was the Solidus wordmark, a "Visit Solidus.io" button, and social icons
        linking to Solidus's GitHub, Stack Overflow and Slack -- starter-template
        boilerplate that was sending New South Botanicals' wholesale customers to
        the ecommerce framework's community.

        Replaced with the store's own name and contact address. Swap in a real
        logo by dropping an SVG into app/assets/images and using image_tag here.
      %>
      <div class="col-span-full mb-14 md:mb-0">
        <div class="mx-auto mb-4 font-serif text-h5 uppercase tracking-wide">
          <%= current_store.name %>
        </div>
        <% if current_store.mail_from_address.present? %>
          <%= mail_to current_store.mail_from_address, class: "text-body-sm underline hover:!text-red-500" %>
        <% end %>
      </div>
    </div>
    <%
      available_locales = current_store.available_locales.map do |locale|
        [
          I18n.t('spree.i18n.this_file_language',
          locale: locale,
          default: locale.to_s,
          fallback: false), locale
        ]
      end.sort
    %>
    <% if available_locales.many? %>
      <div class="locale-selector"  data-controller="locale-selector">
        <%= form_tag select_locale_path do %>
          <div class="locale-selector__select-input select-input">
            <%= label_tag :switch_to_locale, "#{t('spree.i18n.language')}:" %>
            <%= select_tag(:switch_to_locale, options_for_select(available_locales, I18n.locale), data: { action: "locale-selector#submitForm", "locale-selector-target" => "selector" }) %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</footer>
