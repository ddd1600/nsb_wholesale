<%#
  Terms-and-conditions checkbox removed. These are existing wholesale customers
  with an established trading relationship, not retail strangers -- an extra
  mandatory tick between them and reordering is friction for no benefit. The
  starter frontend's placeholder text ("Put your terms and conditions here") was
  never filled in either, so it was asking customers to agree to nothing.
%>
<section class="confirm-step">
  <fieldset class="confirm-step__info">
    <legend class="font-serif text-h5 md:text-h4">
      <%= t('spree.confirm') %>
    </legend>

    <%= render 'orders/order_details', order: @order %>
  </fieldset>

  <div class="flex justify-end py-6 lg:justify-center">
    <%= button_tag(
      I18n.t('spree.place_order'),
      class: 'button-primary',
      name: :commit,
    ) %>
  </div>
</section>

<script>
  Solidus.disableSaveOnClick();
</script>
