<%#
  A card the customer saved with Square at an earlier checkout. Selecting it
  posts order[wallet_payment_source_id]; the charge goes to Square's card on
  file (Nsb::Square::Gateway sends the card id plus the Square customer id).
  No card entry, no browser token.
%>
<% card = wallet_payment_source.payment_source %>

<div class="square-existing-payment">
  <%= card.cc_type.presence&.titleize || "Card" %>
  <% if card.last_digits.present? %>ending <%= card.last_digits %><% end %>
  <% if card.month.present? && card.year.present? %>
    <span class="opacity-75">(expires <%= format("%02d", card.month.to_i) %>/<%= card.year %>)</span>
  <% end %>
  <p class="text-body-xs opacity-75"><%= t("nsb.checkout.saved_card_note") %></p>
</div>
