<ul class="grid-container gap-7 products-grid">
  <% products.each do |product| %>
    <%# Not fragment-cached on purpose: the cached HTML would freeze Active
        Storage's signed image URLs, which expire after minutes -- the cache
        outlived them and every product image 404'd. At ~1 order/day there is
        nothing to gain from caching this anyway. %>
    <%= render ProductCardComponent.new(
      product,
      price: show_wholesale_prices? ? product.price_for_options(current_pricing_options) : nil,
      additional_classes: "col-span-full md:col-span-6 lg:col-span-4"
    ) %>
  <% end %>
</ul>
