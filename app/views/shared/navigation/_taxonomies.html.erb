<% max_level = Spree::Config[:max_level_in_taxons_menu] || 1 %>

<%# Not fragment-cached: the keys are taxonomy records, which do not change when
    a product is discontinued, so a category that just went empty would keep its
    link until something else expired the entry. %>
<nav class="taxonomies flex flex-col">
  <% taxonomies.each do |taxonomy| %>
    <%= render(TaxonsTreeComponent.new(
      title: t('spree.categories'),
      root_taxon: taxonomy.root,
      current_taxon: taxon,
      max_level: max_level,
      item_classes: 'mb-2.5 hover:underline underline-offset-8 w-fit flex',
      current_item_classes: 'underline',
      title_classes: 'font-sans-md mb-3'
      )) %>
  <% end %>
</nav>
