<%#
  Header sign-in dropdown, revealed on hover of the user icon. A shortcut, not a
  replacement: clicking the icon still goes to the full login page.

  Only rendered when signed out. Posts to the same Devise endpoint as the login
  page, so there is no second authentication path to keep secure -- same
  strength, same lockout, same CSRF protection.

  GEOMETRY MATTERS HERE. The panel used to sit at top-8 while the icon is only
  h-6 tall, leaving 0.5rem of dead space between them. Moving the pointer toward
  the panel crossed that gap, the group lost :hover, and the panel vanished
  before you could type. The outer wrapper now starts flush at top-6 and creates
  the visual gap with transparent padding instead, so the pointer never leaves
  the hover area.

  group-focus-within keeps it open while tabbing through the fields.
%>
<%
  # Not rendered when signed in, and not on pages that already carry their own
  # spree_user email/password fields.
  #
  # Without the second guard every such page had TWO fields named
  # spree_user[email] -- the real form plus this shortcut. Password managers and
  # browser autofill then have two candidates and can fill the wrong one, and it
  # broke 14 system specs with Capybara::Ambiguous. Showing a login shortcut on
  # the login page is pointless anyway.
  pages_with_their_own_auth_fields = %w[
    user_sessions user_registrations user_passwords user_confirmations users
  ]
  return if spree_current_user
  return if pages_with_their_own_auth_fields.include?(controller_name)
%>

<div class="absolute right-0 top-6 z-50 hidden pt-2 group-hover:block group-focus-within:block">
<div class="w-72 rounded-lg border border-gray-mid bg-white p-4 shadow-lg dark:border-gray-400 dark:bg-black">
  <%= form_with url: create_new_session_path, method: :post, class: "space-y-3" do %>
    <div class="text-input">
      <%= label_tag "header_user_email", t("spree.email"), class: "text-body-xs" %>
      <%= email_field_tag "spree_user[email]", nil,
            id: "header_user_email",
            placeholder: "name@yourcompany.com",
            autocomplete: "email",
            data: { header_login_target: "email" } %>
    </div>

    <div class="text-input">
      <%= label_tag "header_user_password", t("spree.password"), class: "text-body-xs" %>
      <%= password_field_tag "spree_user[password]", nil,
            id: "header_user_password",
            autocomplete: "current-password" %>
    </div>

    <%= submit_tag t("spree.login"),
          class: "w-full cursor-pointer rounded-full bg-red-500 px-4 py-2 text-body-sm font-bold uppercase tracking-wider text-white hover:bg-red-700" %>
  <% end %>

  <div class="mt-3 flex justify-between text-body-xs">
    <%= link_to "Set up account", claim_path, class: "underline hover:!text-red-500" %>
    <%= link_to t("spree.forgot_password"), recover_password_path, class: "underline hover:!text-red-500" %>
  </div>
</div>
</div>
