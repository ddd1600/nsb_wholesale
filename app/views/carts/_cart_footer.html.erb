<% order = order_form.object %>
<% below_minimum = !order.nsb_meets_minimum_order? %>
<% free_shipping_threshold = nsb_free_shipping_threshold %>

<footer class="cart-footer">
  <%= render 'carts/cart_adjustments' %>
  <p class="cart-footer__total flex justify-between mb-3 text-body-20 p-2">
    <%= t('spree.total') %>: <span class="font-sans-md"><%= order.display_total %></span>
  </p>

  <%# Both measured on item_total, before discounts -- the same figures
      Nsb::MinimumOrder and the free-shipping promotion's rule check. %>
  <% if below_minimum %>
    <p class="mb-3 p-2 text-body-sm font-semibold text-red-700 dark:text-red-400" id="minimum-order-notice">
      <%= t('nsb.minimum_order.cart_short',
            short: Spree::Money.new(order.nsb_amount_short_of_minimum, currency: order.currency),
            minimum: Spree::Money.new(order.nsb_minimum_order_amount, currency: order.currency)) %>
    </p>
  <% end %>
  <% if free_shipping_threshold %>
    <p class="mb-3 p-2 text-body-sm" id="free-shipping-notice">
      <% if order.item_total >= free_shipping_threshold %>
        <%= t('nsb.free_shipping.cart_qualifies') %>
      <% else %>
        <%= t('nsb.free_shipping.cart_short',
              short: Spree::Money.new(free_shipping_threshold - order.item_total, currency: order.currency)) %>
      <% end %>
    </p>
  <% end %>

  <div class="cart-footer__primary-action">
    <%# Disabled as a courtesy; the order state machine is what actually
        refuses to check out under the minimum. %>
    <%= order_form.button(
      I18n.t('spree.checkout'),
      class: "button-primary w-full#{' opacity-50 cursor-not-allowed' if below_minimum}",
      id: 'checkout-link',
      name: :checkout,
      disabled: below_minimum
    ) %>
  </div>
</footer>
